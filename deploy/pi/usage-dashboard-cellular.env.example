# /etc/usage-dashboard-cellular.env — root:root, chmod 600
#
# Settings for the cellular readings worker and its link helper (Plan 010).
# Copy this file there BY HAND and fill it in; cellular-install.sh
# deliberately does not create it, because it carries a credential.
#
#   sudo cp deploy/pi/usage-dashboard-cellular.env.example /etc/usage-dashboard-cellular.env
#   sudo nano /etc/usage-dashboard-cellular.env && sudo chmod 600 /etc/usage-dashboard-cellular.env
#   sudo systemctl restart usage-dashboard-cellular.service
#
# KEY=VALUE lines only, as systemd's EnvironmentFile reads them: no inline
# comments (a trailing "# ..." becomes part of the value), no variable
# expansion. Quote a value in double quotes if it has spaces.

# --- required: the worker exits with EX_CONFIG (78) until each is set -------

# The dashboard, exactly as SERVER_URL in /etc/usage-dashboard-gui.env.
# Cellular mode is "the same GET over verified HTTPS": must be https, port 443.
SERVER_URL=https://dashboard.example
# The read-only display credential: the server Secret key `display-api-key`.
# It reaches the readings route and nothing else — not the GUI's API_KEY.
CELLULAR_DISPLAY_KEY=CHANGE-ME
# The dashboard's address, as IP literals separated by commas — never a name,
# because the link permits no DNS. The hostname above still goes out as SNI
# and Host, so the certificate is verified against the name you trust.
# This must be the address the PUBLIC ingress has, not a split-horizon one.
# Left as a placeholder on purpose: the worker refuses to start on a value
# that is not an address, so an unedited copy of this file cannot run.
CELLULAR_DEST=CHANGE-ME
# The TCP port on CELLULAR_DEST. Leave it at 443 when CELLULAR_DEST is the
# dashboard's own ingress. When the ingress address can change (a home WAN
# address behind DDNS), pin a stable TCP relay in front of it instead and give
# the relay's port here: the relay passes TLS through untouched, so the
# certificate is still verified against SERVER_URL's hostname. SERVER_URL
# itself stays on 443; only the cellular reads use this port.
# CELLULAR_DEST_PORT=443
# The modem's data interface, as `ip -br link` names it with the HAT fitted.
# For an Ethernet-style modem (ECM/RNDIS/NCM) rename it to something stable
# first (README §8); the name is what the firewall and the profile are
# written against.
CELLULAR_IFACE=cell0
# Monthly cap in decimal MB (50 = 50,000,000 bytes), counted from the modem
# interface's own packet counters. Required: the worker will not use a metered
# link without one. A read is roughly 20 KB with the TLS handshake.
CELLULAR_BUDGET_MB=50

# --- the link (read by the root-owned link helper) ---------------------------
# The pre-provisioned NetworkManager profile for this modem and SIM. The
# helper refuses to bring it up unless it is already isolated (no default
# route, no carrier DNS, no autoconnect, metered) — see deploy/pi/README.md §8.
CELLULAR_CONNECTION=cellular-dashboard

# --- optional ------------------------------------------------------------------
# Link-setup packets to permit on the modem: dhcp (the default; what an
# Ethernet-style modem needs), dhcpv6, or none (a raw-IP/QMI/MBIM modem).
# CELLULAR_LINK_SETUP=dhcp
# Allow IPv6 on the link. Leave off unless CELLULAR_DEST includes an IPv6
# address: with it off, every IPv6 packet on the modem interface is dropped.
# CELLULAR_IPV6=0
# CELLULAR_WORKER_USER=usage-dashboard-cellular
# Routing table and rule preference the helper owns. Change them if something
# else on the unit already uses these numbers (`ip rule` to see).
# CELLULAR_TABLE=17010
# CELLULAR_RULE_PREF=17010

# --- cadence, in seconds --------------------------------------------------------
# How often to ask the dashboard over the normal route while it is healthy.
# Free, and it is how recovery is noticed.
# CELLULAR_PROBE_INTERVAL=120
# A single unanswered probe is confirmed after this delay before the modem is
# touched: one lost packet should not cost an LTE attach.
# CELLULAR_RETRY_DELAY=20
# One cellular read per 10 minutes, and only while the panel is lit.
# CELLULAR_POLL_INTERVAL=600
# The floor between cellular reads, so repeated taps on the refresh button
# cannot spend more than one read per minute.
# CELLULAR_MIN_INTERVAL=60
# The longest the worker waits before retrying a failing cellular read.
# CELLULAR_BACKOFF_MAX=3600

# --- rarely changed ---------------------------------------------------------------
# How stale the GUI's "panel is lit" signal may be before the worker treats the
# panel as dark. The GUI refreshes it every 30 s while it is lit.
# CELLULAR_AWAKE_TIMEOUT=150
# Timeouts for one read, in seconds: the TCP connect, waiting for the reply,
# and the name lookup on the normal route.
# CELLULAR_CONNECT_TIMEOUT=8
# CELLULAR_READ_TIMEOUT=15
# CELLULAR_RESOLVE_TIMEOUT=5
# Where the worker keeps its cache, and where it reads the GUI's two signals.
# The GUI's CELLULAR_CACHE (in /etc/usage-dashboard-gui.env) must agree.
# CELLULAR_STATE_DIR=/var/lib/usage-dashboard-cellular
# CELLULAR_REQUEST_DIR=/var/lib/usage-dashboard-cellular/request
# The root-owned helper. This is the path named in the sudoers rule; changing
# it here alone would leave the worker unable to call it.
# CELLULAR_HELPER=/usr/local/bin/usage-dashboard-cellular-link
